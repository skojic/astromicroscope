{
  "name": "Astromicroscope — direction D Midnight Lens",
  "source": "tokens.css",
  "color": {
    "white": "#FFFFFF",
    "beige": "#F3ECE2",
    "ice": "#DCE7F4",
    "uranus": "#2E5BA6",
    "midnight": "#0E1450",
    "gold": "#D4AF5C",
    "gold-text": "#8A6A2A",
    "ink": "#141A33",
    "muted": "#5D6478",
    "line": "#E3DACB",
    "sky-text": "#EAF0F8",
    "gold-foil": "linear-gradient(135deg, #F6E3A1 0%, #D4AF5C 45%, #A47E33 100%)",
    "sky": "radial-gradient(70% 90% at 78% 40%, #1F3384 0, transparent 60%), radial-gradient(50% 60% at 8% 100%, rgba(46, 91, 166, .45) 0, transparent 70%), #0E1450",
    "bg": "var(--am-white)",
    "bg-alt": "var(--am-beige)",
    "text": "var(--am-ink)",
    "text-muted": "var(--am-muted)",
    "action": "var(--am-uranus)",
    "action-hover": "#244B8B",
    "action-on-dark": "var(--am-ice)",
    "focus": "var(--am-uranus)",
    "focus-on-dark": "var(--am-gold)"
  },
  "font": {
    "font-sans": "'Schibsted Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif",
    "font-serif": "'Newsreader', Georgia, 'Times New Roman', serif",
    "text-display": "700 clamp(3rem, 6.2vw, 5.4rem)/.95 var(--am-font-sans)",
    "text-h2": "700 clamp(2.2rem, 4vw, 3.4rem)/1 var(--am-font-sans)",
    "text-h3": "700 1.6rem/1.05 var(--am-font-sans)",
    "text-h4": "600 1.3rem/1.2 var(--am-font-sans)",
    "text-lede": "400 1.3rem/1.5 var(--am-font-serif)",
    "text-body": "400 1.1875rem/1.6 var(--am-font-serif)",
    "text-ui": "600 1rem/1 var(--am-font-sans)",
    "text-small": "400 .9rem/1.4 var(--am-font-sans)",
    "text-label": "500 .85rem/1 var(--am-font-sans)",
    "tracking-display": "-.045em",
    "tracking-heading": "-.035em",
    "measure": "62ch"
  },
  "space": {
    "space-1": "4px",
    "space-2": "8px",
    "space-3": "12px",
    "space-4": "16px",
    "space-5": "24px",
    "space-6": "32px",
    "space-7": "48px",
    "space-8": "64px",
    "space-9": "104px",
    "container": "1240px",
    "gutter": "32px"
  },
  "shape": {
    "radius-card": "6px",
    "radius-pill": "999px",
    "radius-arch": "50% 50% 6px 6px",
    "border": "1px solid var(--am-line)",
    "hairline-gold": "1px solid rgba(212, 175, 92, .5)",
    "shadow-float": "0 6px 24px rgba(14, 20, 80, .2)"
  },
  "motion": {
    "ease": "cubic-bezier(.2, .7, .2, 1)",
    "duration-fast": "150ms",
    "duration": "250ms"
  },
  "breakpoint": {
    "bp-sm": "360px",
    "bp-md": "768px",
    "bp-lg": "1024px",
    "bp-xl": "1440px"
  }
}