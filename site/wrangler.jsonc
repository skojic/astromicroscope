{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astromicroscope",
  "compatibility_date": "2026-11-04",
  // M12-01 (D44): /api/* requests run this script; every other path stays on the static assets (dist/).
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    // The Worker runs before the assets (D59), so it asks them itself (env.ASSETS) whether a path is a page; every page
    // and file the site has is answered by the static assets, exactly as before.
    "binding": "ASSETS",
    // P07 (D59): the Worker answers the paths the static router does not have, which means it has to run for every
    // request: it returns the 410 for the spam URLs, the 404 page for an unknown path, and hands every real page and
    // file to the static assets (D44). A named-rule list cannot cover "every path with a trailing slash" without
    // colliding with the general "/*" rule, so the whole Worker runs first. Before D59 this was ["/api/*"].
    "run_worker_first": true,
    // dist/404.html (sr) and dist/en/404.html (en) are served for unknown paths; see src/integrations/not-found.mjs
    "not_found_handling": "404-page",
    // Astro builds with trailingSlash: 'always' (astro.config.mjs), so folder index files are served with a trailing slash
    "html_handling": "force-trailing-slash"
  },
  // Temporary *.workers.dev address while the site is unfinished; the custom domain is attached at launch (M13), not here.
  "workers_dev": true,
  // D56: the previews are a SEPARATE Worker (`astromicroscope-preview`, see "Preview Worker" in README.md), so a preview
  // deploy never overwrites this Worker on the custom domain. `wrangler preview` is not used: it publishes branches of
  // this Worker, and the custom domain follows the branch. This block is kept for Worker Previews only.
  "previews": {},
  // M12-02 double opt-in: stores the confirmation token -> subscriber id mapping (7-day TTL).
  // M12-04: per-IP rate-limit counters (fixed window) — REUSES the same KV but with short TTL keys.
  // NOTE (2026-11-07): the Cloudflare `send_email` binding was removed. It only delivers to addresses verified in
  // Email Routing, so it cannot send a newsletter confirmation to arbitrary subscribers. MailerLite sends the
  // double-opt-in email itself when the subscriber is created as `unconfirmed` on a double-opt-in group.

  "kv_namespaces": [
    { "binding": "CONFIRM_STORE", "id": "cccb4f92a62d477d94f9e0df46f195aa" },
    { "binding": "RATE_STORE", "id": "3a4d42d289ea46ae83fd4b2aa96a1d42" }
  ]
}
