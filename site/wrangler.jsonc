{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "astromicroscope",
  "compatibility_date": "2026-11-04",
  // M12-01 (D44): /api/* requests run this script; every other path stays on the static assets (dist/).
  "main": "./src/worker/index.ts",
  "assets": {
    "directory": "./dist",
    // Only the /api/ subtree runs the Worker; pages keep serving from the static assets (D44).
    "run_worker_first": ["/api/*"],
    // dist/404.html (sr) and dist/en/404.html (en) are served for unknown paths; see src/integrations/not-found.mjs
    "not_found_handling": "404-page",
    // Astro builds with trailingSlash: 'always' (astro.config.mjs), so folder index files are served with a trailing slash
    "html_handling": "force-trailing-slash"
  },
  // Temporary *.workers.dev address while the site is unfinished; the custom domain is attached at launch (M13), not here.
  "workers_dev": true,
  // Required by `wrangler preview` (per-pull-request previews in CI). Empty: a preview has the same settings as the Worker.
  "previews": {},
  // M12-02 double opt-in: stores the confirmation token -> subscriber id mapping (7-day TTL).
  // M12-04: per-IP rate-limit counters (fixed window) — REUSES the same KV but with short TTL keys.
  // M12-03: Cloudflare Email Service, on the custom domain. Sends the double-opt-in confirmation
  // and the contact/analysis-request emails FROM the zone's domain (noreply@astromicroscope.com).
  "send_email": [
    { "name": "EMAIL_SENDER", "allowed_sender_addresses": ["noreply@astromicroscope.com"] }
  ],
  "kv_namespaces": [
    { "binding": "CONFIRM_STORE", "id": "cccb4f92a62d477d94f9e0df46f195aa" },
    { "binding": "RATE_STORE", "id": "3a4d42d289ea46ae83fd4b2aa96a1d42" }
  ]
}
