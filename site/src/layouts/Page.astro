---
// Every page uses this layout (plan/contracts.md section 5): skip link, header, main, footer. M04 reads the props for <Seo>.
import Base from './Base.astro';
import type { Lang } from '../i18n/core';
import type { Paths } from '../i18n/routes';
import SkipLink from '../components/shell/SkipLink.astro';
import Header from '../components/shell/Header.astro';
import Footer from '../components/shell/Footer.astro';
import Seo from '../components/seo/Seo.astro';
import WebAnalytics from '../components/sections/newsletter/WebAnalytics.astro';

export interface Breadcrumb { name: string; url: string }
interface Props {
  lang: Lang;
  title: string;
  description: string;
  translationKey: string;
  /** The page in each language, for pages that are not in `ROUTES` (articles, horoscope). */
  paths?: Partial<Paths>;
  breadcrumbs?: Breadcrumb[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { lang, title, description, translationKey, paths, breadcrumbs, jsonLd, image, imageAlt, type, noindex } = Astro.props;
---
<Base lang={lang} title={title} description={description}>
  <Seo slot="head" lang={lang} title={title} description={description} translationKey={translationKey} paths={paths} breadcrumbs={breadcrumbs} jsonLd={jsonLd} image={image} imageAlt={imageAlt} type={type} noindex={noindex} />
  <WebAnalytics slot="head" />
  <slot name="head" slot="head" />
  <SkipLink lang={lang} />
  <Header lang={lang} translationKey={translationKey} paths={paths} />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer lang={lang} translationKey={translationKey} paths={paths} />
</Base>
