---
// All SEO head tags (M04-01..03): robots, canonical, hreflang, Open Graph, Twitter, JSON-LD.
// Page.astro passes its props; nobody writes these tags by hand (plan/contracts.md section 5).
import type { Lang } from '../../i18n/core';
import { alternates, type Paths } from '../../i18n/routes';
import { abs, graph, type Crumb, type Json } from './jsonld';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  translationKey: string;
  paths?: Partial<Paths>;
  breadcrumbs?: Crumb[];
  jsonLd?: Json | Json[];
  /** Path of a 1200x630 image; defaults to the site card of the language. */
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}
const { lang, title, description, translationKey, paths, breadcrumbs, jsonLd, image, type = 'website', noindex = false } = Astro.props;
const site = (Astro.site ?? new URL('https://astromicroscope.com')).origin;
const canonical = new URL(Astro.url.pathname, site).href;
const pair = alternates(translationKey, paths);
const hreflang = translationKey === '404' ? {} : pair;
const ogImage = abs(image ?? `/og/default-${lang}.png`, site);
const ogLocale = { sr: 'sr_RS', en: 'en_US' } as const;
const other: Lang = lang === 'sr' ? 'en' : 'sr';
const hide = noindex || import.meta.env.SITE_ENV !== 'production';
const extra = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
const data = graph(lang, extra, breadcrumbs, site);
---
{hide && <meta name="robots" content="noindex" data-page-noindex={noindex ? "" : undefined} />}
<link rel="canonical" href={canonical} />
{Object.entries(hreflang).map(([code, path]) => <link rel="alternate" hreflang={code} href={abs(path, site)} />)}
{hreflang.sr && <link rel="alternate" hreflang="x-default" href={abs(hreflang.sr, site)} />}
<meta property="og:type" content={type} />
<meta property="og:site_name" content="Astromicroscope" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content={ogLocale[lang]} />
{hreflang[other] && <meta property="og:locale:alternate" content={ogLocale[other]} />}
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={Astro.props.imageAlt ?? title} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<script type="application/ld+json" set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />
