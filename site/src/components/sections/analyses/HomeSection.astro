---
// Home section (M09-03): the premium offer — links to the four private analyses. M05 imports this with one prop, `lang`.
import { t, type Lang } from '../../../i18n/core';
import { analysesStrings } from '../../../i18n/analyses';
import { analyses } from '../../../data/analyses';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="analyses-section" aria-labelledby="analyses-title">
  <div class="container">
    <h2 id="analyses-title">{t(analysesStrings, 'hubTitle', lang)}</h2>
    <p class="intro">{t(analysesStrings, 'hubIntro', lang)}</p>
    <ul class="list">
      {analyses.map((a) => (
        <li><a href={`/analize/${a.id}/`}>{a.name.sr}<span class="price">{a.priceEur ? `${a.priceEur} €` : ''}</span></a></li>
      ))}
    </ul>
    <p class="cta"><a href="/analize/">{t(analysesStrings, 'readAnalysis', lang)} →</a></p>
  </div>
</section>
<style>
  .analyses-section { padding: var(--am-space-9) 0; background: var(--am-midnight, #0b1220); color: var(--am-sky-text, #eae0d6); }
  h2 { margin: 0 0 var(--am-space-3); }
  .intro { margin: 0 0 var(--am-space-5); max-width: 64ch; }
  .list { list-style: none; padding: 0; margin: 0 0 var(--am-space-5); display: grid; gap: var(--am-space-3); }
  .list a { display: flex; justify-content: space-between; align-items: center; gap: var(--am-space-3); min-width: 0; padding: var(--am-space-4); border-radius: var(--am-radius); background: rgba(255,255,255,.05); color: inherit; text-decoration: none; }
  .list a:hover { background: rgba(255,255,255,.1); }
  .price { font-weight: 700; opacity: .9; white-space: nowrap; }
  .cta a { color: inherit; }
</style>