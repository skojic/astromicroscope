---
// M09-02: the analyses hub (`/analize/`, `/en/analyses/`), one body for both languages: the premium offer intro + the
// four services.
import Page from '../../../layouts/Page.astro';
import { t, type Lang } from '../../../i18n/core';
import { analysesStrings, shellStrings } from '../../../i18n/strings';
import { pathFor, entryPath } from '../../../i18n/routes';
import { analyses } from '../../../data/analyses';

interface Props { lang: Lang }
const { lang } = Astro.props;
const title = t(analysesStrings, 'hubTitle', lang);
---
<Page lang={lang} title={title} description={t(analysesStrings, 'hubBody', lang)} translationKey="analyses" breadcrumbs={[{ name: t(shellStrings, 'analyses', lang), url: pathFor('analyses', lang) }]} paths={{ sr: pathFor('analyses', 'sr'), en: pathFor('analyses', 'en') }}>
  <div class="analyses">
    <div class="container">
      <h1>{title}</h1>
      <p class="intro">{t(analysesStrings, 'hubIntro', lang)}</p>
      <p class="body">{t(analysesStrings, 'hubBody', lang)}</p>
      <ul class="list">
        {analyses.map((a) => (
          <li>
            <a class="card" href={entryPath('analyses', lang, a.id)}>
              <div>
                <h2>{a.name[lang]}</h2>
                <p class="dur">{a.duration?.[lang] ?? ''}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Page>
<style>
  .analyses { padding: var(--am-space-8) 0 var(--am-space-8); }
  h1 { margin: 0 0 var(--am-space-3); font: var(--am-text-display); }
  .intro { margin: 0 0 var(--am-space-3); font-size: 1.25rem; font-weight: 600; max-width: 64ch; }
  .body { margin: 0 0 var(--am-space-6); max-width: 64ch; line-height: 1.7; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--am-space-4); }
  .card { display: flex; align-items: flex-start; gap: var(--am-space-4); padding: var(--am-space-5); border-radius: var(--am-radius-card); border: 1px solid var(--am-line); text-decoration: none; color: var(--am-ink); justify-content: space-between; transition: border-color var(--am-duration-fast) var(--am-ease), box-shadow var(--am-duration-fast) var(--am-ease); }
  .card:hover { border-color: var(--am-action); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
  .card h2 { margin: 0 0 var(--am-space-1); font: var(--am-text-ui); }
  .card .dur { margin: 0; font-size: .9rem; color: var(--am-muted); }
  .card .arrow { color: var(--am-action); line-height: 1; margin-top: 6px; }
</style>
