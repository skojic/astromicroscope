---
// Home section (M12): newsletter and course-waitlist sign-up. M05 imports this with one prop, `lang`
// (plan/contracts.md section 5). The form posts JSON to /api/newsletter without JavaScript; a small client
// script only adds the honeypot/timestamp/signature fields (D44) and inlines success/error text. Consent copy
// is provisional until Gorica approves it (M12 acceptance criterion).
import { t, type Lang } from '../../../i18n/core';
import { localizedPath } from '../../../i18n/core';
import { newsletterStrings } from '../../../i18n/newsletter';

interface Props { lang: Lang }
const { lang } = Astro.props;
const action = localizedPath(lang, '/api/newsletter');
const tokenUrl = localizedPath(lang, '/api/form-token');
const list = 'newsletter';
const messages = JSON.stringify({
  success: t(newsletterStrings, 'success', lang),
  error: t(newsletterStrings, 'error', lang),
});
---
<section class="newsletter" aria-labelledby="newsletter-title">
  <div class="container">
    <div class="copy">
      <h2 id="newsletter-title">{t(newsletterStrings, 'title', lang)}</h2>
      <p>{t(newsletterStrings, 'intro', lang)}</p>
    </div>
    <form
      class="newsletter-form"
      method="post"
      action={action}
      data-token-url={tokenUrl}
      data-lang={lang}
      data-list={list}
      data-messages={messages}
    >
      <label class="visually-hidden" for="newsletter-email">{t(newsletterStrings, 'emailLabel', lang)}</label>
      <input
        id="newsletter-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        placeholder={t(newsletterStrings, 'emailPlaceholder', lang)}
        required
      />
      <input type="hidden" name="hp" value="" />
      <input type="hidden" name="ts" value="" />
      <input type="hidden" name="sig" value="" />
      <input type="hidden" name="list" value={list} />
      <input type="hidden" name="lang" value={lang} />
      <button type="submit" class="btn">{t(newsletterStrings, 'submit', lang)}</button>
      <p class="consent">{t(newsletterStrings, 'consent', lang)}</p>
      <p class="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<script>
  // M12-04 (D44): without JavaScript the form posts normally and the server rejects it (no challenge attached).
  // This script makes it work: fetch a fresh signed challenge from /api/form-token, put it in the hidden fields,
  // then submit as JSON and render the success/error message inline. No third-party script ever loads.
  const form = document.querySelector<HTMLFormElement>('.newsletter-form');
  if (form) {
    const tokenUrl = new URL(form.dataset.tokenUrl || '/api/form-token', window.location.origin);
    const hpInput = form.querySelector<HTMLInputElement>('input[name="hp"]');
    const tsInput = form.querySelector<HTMLInputElement>('input[name="ts"]');
    const sigInput = form.querySelector<HTMLInputElement>('input[name="sig"]');
    const status = form.querySelector<HTMLElement>('.status');
    const messages = form.dataset.messages ? JSON.parse(form.dataset.messages) : {};
    const successText = messages.success || '';
    const errorText = messages.error || '';

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (status) status.textContent = '';
      try {
        const token = await fetch(tokenUrl).then((r) => r.json());
        if (!token.ok) throw new Error('no token');
        if (tsInput && sigInput) {
          tsInput.value = String(token.ts);
          sigInput.value = token.sig;
        }
        if (hpInput) hpInput.value = '';

        const data = {
          email: form.querySelector<HTMLInputElement>('input[name="email"]')?.value,
          lang: form.dataset.lang,
          list: form.dataset.list,
          hp: hpInput?.value ?? '',
          ts: Number(tsInput?.value),
          sig: sigInput?.value ?? '',
        };
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const out = await res.json();
        if (out.ok && status) status.textContent = successText;
        else if (status) status.textContent = errorText;
      } catch {
        if (status) status.textContent = errorText;
      }
    });
  }
</script>

<style>
  .newsletter { padding: var(--am-space-8) 0; background: var(--am-bg); }
  .container { display: grid; grid-template-columns: minmax(0, 1fr); gap: var(--am-space-5); align-items: start; }
  .copy h2 { margin: 0 0 var(--am-space-3); font-size: clamp(2rem, 3.4vw, 2.9rem); }
  .copy p { margin: 0; max-width: 44ch; text-wrap: pretty; }
  .newsletter-form { display: flex; flex-wrap: wrap; gap: var(--am-space-3); align-items: center; }
  input[type='email'] {
    flex: 1 1 220px; min-width: 0; font: var(--am-text-body); padding: 14px 20px; height: 52px; box-sizing: border-box;
    border-radius: var(--am-radius-pill); border: 1px solid var(--am-line); background: var(--am-white);
  }
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    font: var(--am-text-ui); cursor: pointer; border: 0; height: 52px; padding: 0 26px;
    border-radius: var(--am-radius-pill); background: var(--am-action); color: var(--am-white);
  }
  .btn:hover { background: var(--am-action-hover); }
  .consent { font: var(--am-text-small); line-height: 1.45; color: var(--am-muted); flex-basis: 100%; margin: var(--am-space-1) 0 0; padding-left: 20px; }
  .status { flex-basis: 100%; margin: 0; padding-left: 20px; min-height: 0; }
  .visually-hidden {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }
  @media (min-width: 900px) {
    .container { grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--am-space-9); align-items: center; }
  }
</style>
