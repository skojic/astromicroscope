---
// Home section (M08-01): free learning formats + a clear "Courses in 2027" waitlist CTA. M05 imports this with one prop, `lang`.
import { t, type Lang } from '../../../i18n/core';
import { learnStrings } from '../../../i18n/learn';

interface Props { lang: Lang }
const { lang } = Astro.props;
const p = (s: string, en: string) => (lang === 'sr' ? s : en);
---
<section class="learn-section" aria-labelledby="learn-title">
  <div class="container">
    <h2 id="learn-title">{t(learnStrings, 'hubTitle', lang)}</h2>
    <p class="intro">{t(learnStrings, 'hubIntro', lang)}</p>
    <ul class="links">
      <li><a href={p('/tekstovi/', '/en/articles/')}>{t(learnStrings, 'articlesLink', lang)}</a></li>
      <li><a href={p('/video/', '/en/videos/')}>{t(learnStrings, 'videosLink', lang)}</a></li>
      <li><a href={p('/horoskop/', '/en/horoscope/')}>{t(learnStrings, 'horoscopeLink', lang)}</a></li>
    </ul>
    <p class="waitlist">
      <strong>{t(learnStrings, 'coursesTitle', lang)}</strong> · {t(learnStrings, 'coursesIntro', lang)}
      <a class="btn" href={p('/edukacija/', '/en/learn/')}>{t(learnStrings, 'waitlistBtn', lang)}</a>
      <span class="consent">{t(learnStrings, 'consent', lang)}</span>
    </p>
  </div>
</section>
<style>
  .learn-section { padding: var(--am-space-8) 0; background: var(--am-bg); }
  h2 { margin: 0 0 var(--am-space-5); }
  .intro { margin: 0 0 var(--am-space-5); max-width: 64ch; line-height: 1.7; }
  .links { list-style: none; padding: 0; margin: 0 0 var(--am-space-5); display: flex; flex-wrap: wrap; gap: var(--am-space-3); }
  .links a { display: inline-block; padding: var(--am-space-3) var(--am-space-4); border-radius: var(--am-radius-pill); border: 1px solid var(--am-line); text-decoration: none; color: var(--am-ink); }
  .links a:hover { border-color: var(--am-action); }
  .waitlist { margin: 0; padding: var(--am-space-4); border-radius: var(--am-radius-card); background: var(--am-bg-alt); max-width: 64ch; }
  .btn { display: table; margin-top: var(--am-space-3); padding: 12px 20px; border-radius: var(--am-radius-pill); background: var(--am-action); color: var(--am-white); text-decoration: none; font: var(--am-text-ui); }
  .consent { display: block; margin: var(--am-space-2) 0 0; font: var(--am-text-small); font-size: .8rem; line-height: 1.4; color: var(--am-muted); max-width: 44ch; }
</style>