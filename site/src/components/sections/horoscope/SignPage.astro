---
// M07-02/M07-03: the yearly-horoscope sign page (`/horoskop/<serbian slug>/`, `/en/horoscope/<sign>/`), one body for
// both languages. Renders the sign markdown, the TransitTimeline, the AuthorBox, and Article JSON-LD (M04). The Serbian
// URL uses the Serbian slug (D31).
import Page from '../../../layouts/Page.astro';
import { getCollection, render } from 'astro:content';
import TransitTimeline from '../articles/TransitTimeline.astro';
import AuthorBox from '../about/AuthorBox.astro';
import { article, person, profilePage, graph } from '../../seo/jsonld';
import { t, type Lang } from '../../../i18n/core';
import { horoscopeStrings, signName, SIGN_SLUG_SR, CURRENT_HOROSCOPE_YEAR } from '../../../i18n/horoscope';
import { pathFor, entryPaths } from '../../../i18n/routes';

interface Props { lang: Lang; sign: string }
const { lang, sign } = Astro.props;
const id = `${lang}/${CURRENT_HOROSCOPE_YEAR}/${sign}`;
const entry = (await getCollection('horoscope')).find((e) => e.id === id);
if (!entry) throw new Error(`Missing horoscope entry: ${id}.md`);
const { Content } = await render(entry);
const { title, description, translationKey, answer } = entry.data;
const year = entry.data.year;
const paths = entryPaths('horoscope', { sr: SIGN_SLUG_SR[sign], en: sign });
const url = paths[lang]!;
const jsonLd = graph(lang, [
  article({ headline: title, url, published: `${year}-01-01`, lang, description }),
  person(lang),
  profilePage(lang, url),
]);
---
<Page lang={lang} title={title} description={description} translationKey={translationKey} breadcrumbs={[{ name: t(horoscopeStrings, 'currentYearLabel', lang), url: pathFor('horoscope', lang) }, { name: signName(sign, lang), url }]} jsonLd={jsonLd} paths={paths}>
  <article class="sign-page">
    <div class="container">
      <header class="hero">
        <h1>{title}</h1>
        <p class="answer">{answer}</p>
        <TransitTimeline transits={entry.data.transits} lang={lang} />
        <AuthorBox lang={lang} headingLevel="h3" />
      </header>
      <div class="body">
        <Content />
      </div>
    </div>
  </article>
</Page>
<style>
  .sign-page { padding: var(--am-space-8) 0 var(--am-space-8); }
  .hero { margin-bottom: var(--am-space-6); max-width: var(--am-measure); }
  h1 { margin: 0 0 var(--am-space-4); font: var(--am-text-display); }
  .answer { font-size: 1.125rem; font-weight: 500; margin-bottom: 0; max-width: var(--am-measure); padding: var(--am-space-4); background: var(--am-bg-alt); border-left: 3px solid var(--am-action); }
  .body :global(h2) { margin: var(--am-space-7) 0 var(--am-space-4); font-size: clamp(1.7rem, 3vw, 2.2rem); }
  .body :global(h3) { margin: var(--am-space-6) 0 var(--am-space-3); }
  .body :global(p) { max-width: var(--am-measure); line-height: 1.75; }
  .body :global(blockquote) { margin: var(--am-space-6) 0; padding-left: var(--am-space-4); border-left: 3px solid var(--am-action); font-style: italic; }
  .body :global(a) { color: var(--am-action); }
  .body :global(ul), .body :global(ol) { padding-left: var(--am-space-4); }
  .body :global(li) { line-height: 1.75; }
</style>
