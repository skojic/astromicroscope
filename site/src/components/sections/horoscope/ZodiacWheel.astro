---
// Zodiac wheel / sign grid (M07-01): a navigable list of all 12 sign links. No JS needed (works for keyboard/screen
// readers); a JS lens/preview enhancement can layer on later. 3×4 grid under 768 px.
import { t, type Lang } from '../../../i18n/core';
import { horoscopeStrings } from '../../../i18n/horoscope';
import { signName, SIGN_SLUG_SR } from '../../../i18n/horoscope';

interface Props {
  lang: Lang;
  year: number;
  headingLevel?: 'h2' | 'h3';
}
const { lang, year, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
const signs = Object.keys(SIGN_SLUG_SR);
---
<nav class="zodiac" aria-label={t(horoscopeStrings, 'ariaSignLinks', lang)}>
  <div class="grid">
    {signs.map((sign) => {
      const slug = SIGN_SLUG_SR[sign];
      // SR links now; the /en/horoscope/** mirror arrives with M14.
      const href = `/horoskop/${slug}/`;
      return (
        <a class="sign" href={href}>
          <span class="dot" aria-hidden="true"></span>
          <span class="name">{signName(sign, lang)}</span>
          <span class="year">{year}</span>
        </a>
      );
    })}
  </div>
</nav>
<style>
  .grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--am-space-3); list-style: none; padding: 0; margin: 0; }
  .sign {
    display: flex; flex-direction: column; align-items: center; gap: var(--am-space-1);
    padding: var(--am-space-4); border-radius: var(--am-radius); text-decoration: none;
    border: 1px solid var(--am-line, #d3d8df); transition: border-color var(--am-duration-fast) var(--am-ease), box-shadow var(--am-duration-fast) var(--am-ease);
    color: var(--am-ink);
  }
  .sign:hover { border-color: var(--am-action); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
  .sign:focus-visible { outline: 2px solid var(--am-focus); outline-offset: 2px; }
  .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--am-action); }
  .name { font: var(--am-text-ui); font-weight: 600; }
  .year { font: var(--am-text-small, var(--am-text-body)); color: var(--am-muted); }
  @media (max-width: 767px) { .grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 480px) { .grid { grid-template-columns: repeat(2, 1fr); } }
</style>