---
// M10-01: the About page (`/o-meni/`, `/en/about/`), one body for both languages. Renders the about page content and
// the AuthorBox, with Person + ProfilePage JSON-LD (M04).
import Page from '../../../layouts/Page.astro';
import { getCollection, render } from 'astro:content';
import AuthorBox from './AuthorBox.astro';
import { person, profilePage, graph } from '../../seo/jsonld';
import { t, type Lang } from '../../../i18n/core';
import { shellStrings } from '../../../i18n/strings';
import { pathFor } from '../../../i18n/routes';

interface Props { lang: Lang }
const { lang } = Astro.props;
const id = lang === 'sr' ? 'sr/o-meni' : 'en/about';
const entry = (await getCollection('pages')).find((e) => e.id === id);
if (!entry) throw new Error(`Missing content page: pages/${id}.md`);
const { Content } = await render(entry);
const { title, description, translationKey } = entry.data;
const url = pathFor('about', lang);
const jsonLd = graph(lang, [person(lang), profilePage(lang, url)]);
---
<Page lang={lang} title={title} description={description} translationKey={translationKey} breadcrumbs={[{ name: t(shellStrings, 'about', lang), url }]} jsonLd={jsonLd} paths={{ sr: pathFor('about', 'sr'), en: pathFor('about', 'en') }}>
  <article class="about">
    <header class="hero">
      <div class="container">
        <h1>{title.replace(/ · .*/, '')}</h1>
        <AuthorBox lang={lang} />
      </div>
    </header>
    <div class="container body">
      <Content />
    </div>
  </article>
</Page>
<style>
  .about { padding: var(--am-space-8) 0 var(--am-space-8); }
  .hero { margin-bottom: var(--am-space-7); }
  .hero .container, .body { margin-inline: auto; } /* keep centered, content below caps width */
  h1 { margin: 0 0 var(--am-space-5); font: var(--am-text-display); max-width: var(--am-measure); }
  .body :global(h2) { margin: var(--am-space-7) 0 var(--am-space-4); font-size: clamp(1.7rem, 3vw, 2.2rem); }
  .body :global(p) { max-width: var(--am-measure); line-height: 1.7; }
  .body :global(blockquote) { margin: var(--am-space-6) 0; padding-left: var(--am-space-4); border-left: 3px solid var(--am-action); font-style: italic; max-width: var(--am-measure); }
  .body :global(a) { color: var(--am-action); }
</style>
