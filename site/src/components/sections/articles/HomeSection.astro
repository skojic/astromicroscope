---
// Home section (M06-04): one featured article + three more, linking to /tekstovi/. M05 imports this with one prop, `lang`.
import { getCollection } from 'astro:content';
import { t, type Lang } from '../../../i18n/core';
import { articleStrings } from '../../../i18n/articles';

const lang: Lang = 'sr';
const items = (await getCollection('articles'))
  .filter((e) => e.id.startsWith('sr/'))
  .sort((a, b) => {
    const av = a.data.published instanceof Date ? a.data.published.getTime() : new Date(String(a.data.published)).getTime();
    const bv = b.data.published instanceof Date ? b.data.published.getTime() : new Date(String(b.data.published)).getTime();
    return bv - av;
  });
const featured = items[0];
const rest = items.slice(1, 4);
interface Shared { href: string; title: string; description: string }
const featuredCard: Shared | null = featured ? { href: `/tekstovi/${featured.id.replace('sr/', '')}/`, title: featured.data.title, description: featured.data.description } : null;
const restCards: Shared[] = rest.map((i) => ({ href: `/tekstovi/${i.id.replace('sr/', '')}/`, title: i.data.title, description: i.data.description }));
---
<section class="articles" aria-labelledby="articles-title">
  <div class="container">
    <h2 id="articles-title">{t(articleStrings, 'latestTitle', lang)}</h2>
    {featuredCard && (
      <a class="featured" href={featuredCard.href}>
        <h3>{featuredCard.title}</h3>
        <p>{featuredCard.description}</p>
      </a>
    )}
    <ul class="list">
      {restCards.map((c) => (
        <li><a class="card" href={c.href}><h3>{c.title}</h3><p>{c.description}</p></a></li>
      ))}
    </ul>
    <p class="actions"><a href="/tekstovi/">{t(articleStrings, 'allArticles', lang)} →</a></p>
  </div>
</section>
<style>
  .articles { padding: var(--am-space-9) 0; background: var(--am-bg); }
  h2 { margin-bottom: var(--am-space-5); }
  .featured { display: block; padding: var(--am-space-5); border-radius: var(--am-radius); background: var(--am-bg-subtle, #f4f1ea); text-decoration: none; color: var(--am-ink); margin-bottom: var(--am-space-4); }
  .featured h3 { margin: 0 0 var(--am-space-2); font: var(--am-text-ui); }
  .featured p { margin: 0; line-height: 1.6; }
  .list { list-style: none; padding: 0; margin: 0 0 var(--am-space-4); display: grid; gap: var(--am-space-3); }
  .card { display: block; padding: var(--am-space-4); border-radius: var(--am-radius); border: 1px solid var(--am-line, #d3d8df); text-decoration: none; color: var(--am-ink); }
  .card h3 { margin: 0 0 var(--am-space-1); font: var(--am-text-ui); }
  .card p { margin: 0; line-height: 1.6; font-size: .95rem; }
  .actions a { color: var(--am-action); }
</style>