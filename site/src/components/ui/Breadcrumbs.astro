---
// Visible breadcrumbs (specs/01). Pass the same list to Page's `breadcrumbs` so the JSON-LD matches.
interface Props { items: { name: string; url: string }[]; label?: string }
const { items, label = 'Breadcrumb' } = Astro.props;
---
<nav aria-label={label} class="crumbs">
  <ol>
    {items.map((item, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{item.name}</span> : <a href={item.url}>{item.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs ol { display: flex; flex-wrap: wrap; gap: var(--am-space-2); list-style: none; margin: 0; padding: var(--am-space-5) 0 var(--am-space-3); font: var(--am-text-small); color: var(--am-text-muted); }
  .crumbs li + li::before { content: '/'; margin-right: var(--am-space-2); }
  .crumbs a { color: var(--am-text-muted); }
  .crumbs a:hover { color: var(--am-action-hover); }
</style>
