---
// Header, navigation and mobile menu (M03-01, M03-02). Fixed height, so it never shifts the layout.
import { t, stripLang, type Lang } from '../../i18n/core';
import { pathFor, type Paths, type RouteKey } from '../../i18n/routes';
import { shellStrings } from '../../i18n/shell';
import mark from '../../assets/logo/mark-midnight.svg?url';
import LanguageSwitch from './LanguageSwitch.astro';
import Button from '../ui/Button.astro';

interface Props { lang: Lang; translationKey: string; paths?: Partial<Paths> }
const { lang, translationKey, paths } = Astro.props;
const items: RouteKey[] = ['learn', 'articles', 'videos', 'analyses', 'about'];
const here = Astro.url.pathname;
const isCurrent = (key: RouteKey) => here.startsWith(pathFor(key, lang));
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href={pathFor('home', lang)}>
      <img src={mark} alt="" width="36" height="44" />
      <span class="words"><span class="name">Astromicroscope</span><span class="sub">{t(shellStrings, 'subtitle', lang)}</span></span>
    </a>
    <button type="button" class="toggle" aria-expanded="false" aria-controls="site-nav" data-open={t(shellStrings, 'menuOpen', lang)} data-close={t(shellStrings, 'menuClose', lang)}>
      {t(shellStrings, 'menuOpen', lang)}
    </button>
    <div class="menu" id="site-nav" data-menu>
      <nav aria-label={t(shellStrings, 'navLabel', lang)}>
        <ul>
          {items.map((key) => (
            <li><a href={pathFor(key, lang)} aria-current={isCurrent(key) ? 'page' : undefined}>{t(shellStrings, key, lang)}</a></li>
          ))}
        </ul>
      </nav>
      <LanguageSwitch lang={lang} translationKey={translationKey} paths={paths} />
      <Button href={pathFor('learn', lang)}>{t(shellStrings, 'cta', lang)}</Button>
    </div>
  </div>
</header>

<style>
  .site-header { background: var(--am-bg); border-bottom: var(--am-border); }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: var(--am-space-4); min-height: 72px; position: relative; }
  .brand { display: inline-flex; align-items: center; gap: var(--am-space-3); text-decoration: none; color: var(--am-midnight); }
  .brand img { display: block; }
  .words { display: flex; flex-direction: column; line-height: 1.1; }
  .name { font: 500 1.35rem/1.1 var(--am-font-serif); }
  .sub { font: var(--am-text-small); color: var(--am-text-muted); }
  .toggle {
    font: var(--am-text-ui); background: transparent; color: var(--am-ink); cursor: pointer;
    border: 0; border-radius: var(--am-radius-pill); box-shadow: inset 0 0 0 1.5px var(--am-ink);
    padding: 0 18px; min-height: 44px; line-height: 1; display: inline-flex; align-items: center;
  }
  .menu { display: none; }
  .menu nav ul { display: flex; flex-direction: column; gap: var(--am-space-1); list-style: none; margin: 0; padding: 0; }
  .menu nav a { display: block; padding: var(--am-space-3) 0; font: var(--am-text-ui); text-decoration: none; color: var(--am-ink); }
  .menu nav a:hover { color: var(--am-action-hover); }
  .menu nav a[aria-current='page'] { box-shadow: 0 2px 0 var(--am-gold); }

  /* Phone: the menu opens as a panel under the header */
  .menu[data-open='true'] {
    display: flex; flex-direction: column; align-items: flex-start; gap: var(--am-space-4);
    position: absolute; inset: 100% 0 auto 0; z-index: 10;
    background: var(--am-bg); border-bottom: var(--am-border); padding: var(--am-space-4) 0 var(--am-space-5);
    box-shadow: var(--am-shadow-float);
  }
  @media (max-width: 480px) { .sub { display: none; } }

  @media (min-width: 1024px) {
    .toggle { display: none; }
    .menu { display: flex; align-items: center; gap: var(--am-space-5); }
    .menu nav ul { flex-direction: row; gap: var(--am-space-5); }
    .menu nav a { padding: var(--am-space-2) 0; }
    .menu :global(.langs) { margin-right: var(--am-space-1); }
    .menu :global(.btn) { margin-left: var(--am-space-1); }
  }
</style>

<script>
  // The only script in the shell: toggles the phone menu. Focus moves into the menu on open and back to the button on Escape.
  const toggle = document.querySelector<HTMLButtonElement>('.site-header .toggle');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  if (toggle && menu) {
    const setOpen = (open: boolean, restoreFocus = false) => {
      menu.dataset.open = String(open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.textContent = open ? toggle.dataset.close! : toggle.dataset.open!;
      if (open) menu.querySelector<HTMLElement>('a')?.focus();
      else if (restoreFocus) toggle.focus();
    };
    toggle.addEventListener('click', () => setOpen(menu.dataset.open !== 'true'));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.dataset.open === 'true') setOpen(false, true);
    });
  }
</script>
