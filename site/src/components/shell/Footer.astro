---
// Footer (M03-04): the same links and the same contact on every page (WCAG 3.2.6).
import { t, type Lang } from '../../i18n/core';
import { pathFor, type Paths, type RouteKey } from '../../i18n/routes';
import { shellStrings } from '../../i18n/shell';
import mark from '../../assets/logo/mark-white.svg?url';
import LanguageSwitch from './LanguageSwitch.astro';

interface Props { lang: Lang; translationKey: string; paths?: Partial<Paths> }
const { lang, translationKey, paths } = Astro.props;
const explore: RouteKey[] = ['learn', 'articles', 'videos', 'analyses', 'about'];
const info: RouteKey[] = ['contact'];
const year = new Date().getFullYear();
---
<footer class="site-footer on-dark">
  <div class="container grid">
    <div class="who">
      <a class="brand" href={pathFor('home', lang)}>
        <img src={mark} alt="" width="36" height="44" loading="lazy" decoding="async" />
        <span><span class="name">Astromicroscope</span><br /><span class="sub">{t(shellStrings, 'subtitle', lang)}</span></span>
      </a>
      <LanguageSwitch lang={lang} translationKey={translationKey} paths={paths} />
    </div>
    <nav aria-labelledby="f-explore">
      <h2 id="f-explore">{t(shellStrings, 'footerExplore', lang)}</h2>
      <ul>{explore.map((key) => <li><a href={pathFor(key, lang)}>{t(shellStrings, key, lang)}</a></li>)}</ul>
    </nav>
    <nav aria-labelledby="f-info">
      <h2 id="f-info">{t(shellStrings, 'footerInfo', lang)}</h2>
      <ul>{info.map((key) => <li><a href={pathFor(key, lang)}>{t(shellStrings, key, lang)}</a></li>)}</ul>
    </nav>
    <div>
      <h2 id="f-follow">{t(shellStrings, 'footerFollow', lang)}</h2>
      <ul aria-labelledby="f-follow">
        <li><a href="mailto:astromicroscope@gmail.com">{t(shellStrings, 'email', lang)}</a></li>
        <li><a href="https://www.instagram.com/astromicroscope/" rel="noopener">{t(shellStrings, 'instagram', lang)}</a></li>
        <li><a href="https://www.youtube.com/@astromicroscope" rel="noopener">{t(shellStrings, 'youtube', lang)}</a></li>
      </ul>
    </div>
  </div>
  <p class="container rights">© {year} {t(shellStrings, 'rights', lang)}</p>
</footer>
<style>
  .site-footer { background: var(--am-midnight); color: var(--am-sky-text); padding: var(--am-space-8) 0 var(--am-space-6); margin-top: var(--am-space-9); font: var(--am-text-small); }
  .grid { display: grid; gap: var(--am-space-6); grid-template-columns: 1fr; }
  @media (min-width: 768px) { .grid { grid-template-columns: 1.4fr 1fr 1fr 1.2fr; } }
  .brand { display: inline-flex; align-items: center; gap: var(--am-space-3); color: var(--am-sky-text); text-decoration: none; margin-bottom: var(--am-space-4); }
  .name { font: 500 1.25rem/1.2 var(--am-font-serif); }
  h2 { font: var(--am-text-label); letter-spacing: .08em; text-transform: uppercase; color: var(--am-gold); margin-bottom: var(--am-space-3); }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--am-space-1); }
  a { color: var(--am-sky-text); display: inline-block; padding: var(--am-space-1) 0; text-underline-offset: .18em; }
  a:hover { color: var(--am-white); }
  .rights { margin: var(--am-space-7) auto 0; padding-top: var(--am-space-5); border-top: var(--am-hairline-gold); color: var(--am-sky-text); max-width: none; }
  /* language switch on dark */
  .who :global(a) { color: var(--am-sky-text); }
  .who :global(a[aria-current='true']) { color: var(--am-white); box-shadow: inset 0 0 0 1.5px var(--am-gold); }
</style>
