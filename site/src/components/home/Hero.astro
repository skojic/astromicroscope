---
// Home hero (M05-01). The H1 is HTML text and the LCP element; nothing here waits for JavaScript to paint.
import { t, type Lang } from '../../i18n/core';
import { pathFor } from '../../i18n/routes';
import { homeStrings } from '../../i18n/home';
import Button from '../ui/Button.astro';
import ChartLens from './ChartLens.astro';
import StarField from './StarField.astro';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<section class="sky on-dark">
  <StarField />
  <div class="container hero">
    <div class="copy">
      <h1>{t(homeStrings, 'h1', lang)}</h1>
      <p class="lede">{t(homeStrings, 'lede', lang)}</p>
      <div class="ctas">
        <Button href={pathFor('learn', lang)} onDark>{t(homeStrings, 'ctaLearn', lang)}</Button>
        <Button href={pathFor('analyses', lang)} variant="ghost" onDark>{t(homeStrings, 'ctaAnalyses', lang)}</Button>
      </div>
    </div>
    <ChartLens lang={lang} />
  </div>
</section>
<style>
  .sky { position: relative; isolation: isolate; overflow: hidden; background: var(--am-sky); color: var(--am-sky-text); }
  .hero { display: grid; gap: var(--am-space-7); align-items: center; padding: var(--am-space-7) 0 var(--am-space-8); }
  @media (min-width: 900px) { .hero { grid-template-columns: 1fr 1.05fr; gap: 48px; padding: var(--am-space-8) 0 var(--am-space-9); } }
  h1 { color: var(--am-white); margin-bottom: var(--am-space-5); }
  .lede { font: var(--am-text-lede); max-width: 32ch; margin-bottom: var(--am-space-6); color: rgba(234, 240, 248, .86); }
  .ctas { display: flex; flex-wrap: wrap; gap: var(--am-space-3); }
</style>
