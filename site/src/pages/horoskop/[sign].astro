---
// The Serbian sign page lives at /horoskop/<serbian slug>/ (D31).
import SignPage from '../../components/sections/horoscope/SignPage.astro';
import { SIGN_SLUG_SR } from '../../i18n/horoscope';
export function getStaticPaths() {
  return Object.entries(SIGN_SLUG_SR).map(([sign, slug]) => ({ params: { sign: slug }, props: { sign } }));
}
---
<SignPage lang="sr" sign={Astro.props.sign} />
