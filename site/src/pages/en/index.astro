---
// Home page (M05-04): hero, then the section modules in the order of plan/concept.md. A section that does not exist yet shows Pending.
import Page from '../../layouts/Page.astro';
import Hero from '../../components/home/Hero.astro';
import Sections from '../../components/home/Sections.astro';
import { t } from '../../i18n/core';
import { homeStrings } from '../../i18n/home';
const lang = 'en';
---
<Page lang={lang} title={t(homeStrings, 'title', lang)} description={t(homeStrings, 'description', lang)} translationKey="home">
  <Hero lang={lang} />
  <Sections lang={lang} />
</Page>
