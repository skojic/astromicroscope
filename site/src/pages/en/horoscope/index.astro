---
// M07-03 EN: the horoscope hub (`/en/horoscope/`): a titled intro + the zodiac wheel linking all 12 signs.
import Page from '../../../layouts/Page.astro';
import { t } from '../../../i18n/core';
import { horoscopeStrings } from '../../../i18n/horoscope';
import ZodiacWheel from '../../../components/sections/horoscope/ZodiacWheel.astro';
import { getCollection } from 'astro:content';

const lang = 'en';
const year = 2026;
// The lens shows each sign's opening paragraph (the `answer` of its page, M07-05).
const answers = Object.fromEntries(
  (await getCollection('horoscope', (e) => e.data.lang === 'en' && e.data.year === year)).map((e) => [e.data.sign, e.data.answer]),
);
const title = t(horoscopeStrings, 'hubTitle', lang);
const description = t(horoscopeStrings, 'hubIntro', lang);
const url = '/en/horoscope/';
---
<Page lang={lang} title={title} description={description} translationKey="horoscope" breadcrumbs={[{ name: 'Yearly horoscope', url }]}>
  <div class="hub">
    <div class="container">
      <h1>{title}</h1>
      <p class="intro">{t(horoscopeStrings, 'listIntro', lang)}</p>
      <ZodiacWheel lang={lang} year={year} answers={answers} />
    </div>
  </div>
</Page>
<style>
  .hub { padding: var(--am-space-8) 0 var(--am-space-8); }
  h1 { margin: 0 0 var(--am-space-4); font: var(--am-text-display); }
  .intro { margin: 0 0 var(--am-space-6); max-width: 64ch; }
</style>