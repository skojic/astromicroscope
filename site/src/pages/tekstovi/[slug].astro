---
import { getCollection } from 'astro:content';
import ArticlePage from '../../components/sections/articles/ArticlePage.astro';
import { articleSlug } from '../../components/sections/articles/entries';
export async function getStaticPaths() {
  return (await getCollection('articles', (e) => e.id.startsWith('sr/'))).map((entry) => ({ params: { slug: articleSlug(entry.id) }, props: { entry } }));
}
---
<ArticlePage lang="sr" entry={Astro.props.entry} />
