---
// M09-02: the analyses hub (`/analize/`): the premium offer intro + the four services.
import Page from '../../layouts/Page.astro';
import { t } from '../../i18n/core';
import { analysesStrings } from '../../i18n/analyses';
import { analyses } from '../../data/analyses';

const lang = 'sr';
const title = t(analysesStrings, 'hubTitle', lang);
const description = t(analysesStrings, 'hubIntro', lang);
---
<Page lang={lang} title={title} description={t(analysesStrings, 'hubBody', lang)} translationKey="analyses" breadcrumbs={[{ name: 'Individualne analize', url: '/analize/' }]}>
  <div class="analyses">
    <div class="container">
      <h1>{title}</h1>
      <p class="intro">{t(analysesStrings, 'hubIntro', lang)}</p>
      <p class="body">{t(analysesStrings, 'hubBody', lang)}</p>
      <ul class="list">
        {analyses.map((a) => (
          <li>
            <a class="card" href={`/analize/${a.id}/`}>
              <div>
                <h2>{a.name.sr}</h2>
                <p class="dur">{a.duration?.sr ?? ''}</p>
              </div>
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>
</Page>
<style>
  .analyses { padding: var(--am-space-8) 0 var(--am-space-8); }
  h1 { margin: 0 0 var(--am-space-3); font: var(--am-text-display); }
  .intro { margin: 0 0 var(--am-space-3); font-size: 1.25rem; font-weight: 600; max-width: 64ch; }
  .body { margin: 0 0 var(--am-space-6); max-width: 64ch; line-height: 1.7; }
  .list { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--am-space-4); }
  .card { display: flex; align-items: flex-start; gap: var(--am-space-4); padding: var(--am-space-5); border-radius: var(--am-radius); border: 1px solid var(--am-line, #d3d8df); text-decoration: none; color: var(--am-ink); justify-content: space-between; transition: border-color var(--am-duration-fast) var(--am-ease), box-shadow var(--am-duration-fast) var(--am-ease); }
  .card:hover { border-color: var(--am-action); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
  .card h2 { margin: 0 0 var(--am-space-1); font: var(--am-text-ui); }
  .card .dur { margin: 0; font-size: .9rem; color: var(--am-muted); }
  .card .arrow { color: var(--am-action); line-height: 1; margin-top: 6px; }
</style>