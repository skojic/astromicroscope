{
  "name": "site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "node scripts/sync-brand.mjs --check && node scripts/check-content.mjs",
    "test": "node --test test/*.test.ts",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "sync:brand": "node scripts/sync-brand.mjs",
    "test:html": "html-validate dist",
    "test:axe": "node scripts/axe.mjs",
    "test:lighthouse": "lhci autorun",
    "import:videos": "node scripts/import-videos.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "test:seo": "node scripts/seo-check.mjs",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy:preview": "npm run build && wrangler deploy",
    "test:visual": "node scripts/visual.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "status:sync": "node scripts/check-docs.mjs --fix",
    "test:links": "node scripts/check-external-links.mjs",
    "smoke": "node scripts/smoke.mjs",
    "crawl": "node scripts/crawl.mjs",
    "check:redirects": "node scripts/check-redirects.mjs",
    "test:lighthouse:live": "lhci autorun --config=./lighthouserc.live.json"
  },
  "dependencies": {
    "astro": "7.4.5",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@lhci/cli": "0.16.0",
    "html-validate": "11.17.0",
    "playwright": "1.64.1",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "basic-ftp": "6.2.5",
    "@sentry/bundler-plugins": {
      "glob": "14.0.3"
    },
    "@lhci/cli": {
      "chrome-launcher": "1.2.2"
    }
  }
}
